{
  "id": "isaac-lab",
  "name": "Isaac Lab",
  "category": "simulation",
  "summary": "Isaac Lab checkout installed into the Isaac environment.",
  "requires": [
    "isaac"
  ],
  "components": [
    "isaac-lab"
  ],
  "run": [
    {
      "name": "Isaac Lab: list environments",
      "cmd": "cd \"$ISAACLAB_DIR\" && ./isaaclab.sh -p scripts/environments/list_envs.py",
      "env": "isaac",
      "workspace": "isaac"
    }
  ]
}
