<?xml version="1.0"?>
<!-- A two-link arm: the smallest URDF worth loading. Replace it with your own robot.
     The <mujoco> block keeps the <visual> shapes, which MuJoCo otherwise drops.
     The shoulder sits 5 cm above the base box and the upper link starts 4 cm along,
     so the link clears the box when it swings: shapes that touch at a joint block it. -->
<robot name="twolink">
  <mujoco><compiler discardvisual="false"/></mujoco>
  <link name="base">
    <inertial><mass value="2"/><inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.2 0.2 0.1"/></geometry></visual>
    <collision><geometry><box size="0.2 0.2 0.1"/></geometry></collision>
  </link>
  <link name="upper">
    <inertial><origin xyz="0 0 0.15"/><mass value="0.5"/><inertia ixx="0.005" iyy="0.005" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.17"/><geometry><cylinder radius="0.025" length="0.26"/></geometry></visual>
    <collision><origin xyz="0 0 0.17"/><geometry><cylinder radius="0.025" length="0.26"/></geometry></collision>
  </link>
  <link name="lower">
    <inertial><origin xyz="0 0 0.15"/><mass value="0.3"/><inertia ixx="0.003" iyy="0.003" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.02" length="0.3"/></geometry></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.02" length="0.3"/></geometry></collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper"/><origin xyz="0 0 0.10"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="20" velocity="6"/><dynamics damping="0.3"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper"/><child link="lower"/><origin xyz="0 0 0.3"/><axis xyz="0 1 0"/>
    <limit lower="-2.3" upper="2.3" effort="12" velocity="6"/><dynamics damping="0.2"/>
  </joint>
</robot>
